# Copy to .env and fill in real values. Never commit .env itself.

# JWT signing secret. MUST be identical to apps/ws-backend/.env, otherwise
# tokens signed here fail verification over there. Use a long random string.
JWT_SECRET="replace-with-a-long-random-string"

# Postgres connection string. Same value as packages/db-package/.env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional. Hosts like Render/Railway inject PORT; local default is 3001.
PORT=3001

# Comma-separated list of allowed frontend origins for CORS. Local default is
# http://localhost:3000; add your deployed frontend URL for hosting.
# FRONTEND_ORIGIN="http://localhost:3000,https://your-frontend.vercel.app"

# Set by the host/framework. "production" makes the session cookie HTTPS-only.
# NODE_ENV=production