# Copy to .env.local (Next.js) and fill in real values.
# These are NEXT_PUBLIC_*: baked into the browser bundle at build time, so
# they must be the PUBLIC URLs of your deployed backends, not secrets.

# HTTP API origin. Local default: http://localhost:3001
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"

# WebSocket origin. Local default: ws://localhost:8080
# In production use wss:// (TLS), matching your HTTPS frontend.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"