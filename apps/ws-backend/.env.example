# Copy to .env and fill in real values. Never commit .env itself.

# JWT signing secret. MUST be identical to apps/http-backend/.env so the
# handshake can verify the cookie the HTTP backend issued.
JWT_SECRET="replace-with-the-same-long-random-string"

# Postgres connection string. Same value as packages/db-package/.env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional. Hosts inject PORT; local default is 8080.
PORT=8080